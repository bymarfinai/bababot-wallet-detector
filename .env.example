# Optional Solana JSON-RPC endpoint for Stage 10A-0 automatic discovery.
# Defaults to public Solana mainnet RPC when unset.
# A Helius/other compatible RPC URL may be supplied here instead.
SOLANA_RPC_URL=
SOLANA_RPC_SOURCE_LABEL=solana-json-rpc

# Wallet Detector Supabase project (public project URL; safe to commit).
WALLET_SUPABASE_URL=https://yuqkodwdqaggsexbqiqa.supabase.co

# Server-side Supabase secret used by Python historical backfill / persistence.
# Keep empty in git. Never expose with NEXT_PUBLIC_.
WALLET_SUPABASE_SECRET_KEY=

# Helius key used only by historical/live server-side ingestion.
# Keep empty in git.
HELIUS_API_KEY=

# Optional Stage 8 runtime dashboard endpoint.
# Leave unset to show explicit DEMO mode.
WALLET_DETECTOR_DASHBOARD_URL=

# Optional bearer token used only by the server-side dashboard adapter.
# Never expose this with a NEXT_PUBLIC_ prefix.
WALLET_DETECTOR_DASHBOARD_TOKEN=
